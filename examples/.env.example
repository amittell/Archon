# Archon Examples - Environment Configuration
# Copy this file to .env and fill in your API keys

# ============================================================================
# LLM Configuration
# ============================================================================

# Primary model for code generation (default: gpt-4o-mini)
# Options: gpt-4o, gpt-4o-mini, gpt-4-turbo, claude-3-5-sonnet-20241022
PRIMARY_MODEL=gpt-4o-mini

# Reasoner model for scope definition (default: o3-mini)
# This model is used for the initial scope/planning phase
# Options: o3-mini, o1-mini, gpt-4o, gpt-4o-mini
REASONER_MODEL=o3-mini

# LLM API base URL (default: OpenAI)
# For OpenAI: https://api.openai.com/v1
# For Ollama: http://localhost:11434/v1
# For other providers: see their documentation
BASE_URL=https://api.openai.com/v1

# LLM API Key (required for most providers)
LLM_API_KEY=your_llm_api_key_here

# ============================================================================
# OpenAI Configuration (for embeddings and some models)
# ============================================================================

# OpenAI API key (required for RAG embeddings)
OPENAI_API_KEY=your_openai_api_key_here

# ============================================================================
# Supabase Configuration (for RAG documentation storage)
# ============================================================================

# Supabase project URL
# Get from: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co

# Supabase service role key (has full database access)
# Get from: https://app.supabase.com/project/_/settings/api
# WARNING: Keep this secret! Never commit to version control
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# ============================================================================
# V4/V6 Configuration (Validation and Checkpointing)
# ============================================================================

# Checkpoint database location for conversation persistence (V4+)
# Default: workbench/checkpoints.db
# Set to an absolute path for production deployments
CHECKPOINT_DB=workbench/checkpoints.db

# ============================================================================
# Example-Specific Configuration
# ============================================================================

# Weather Agent Example
# Get a free API key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ============================================================================
# Optional: Local Model Configuration (Ollama)
# ============================================================================

# To use local models with Ollama:
# 1. Install Ollama: https://ollama.ai
# 2. Pull a model: ollama pull codellama
# 3. Configure:
# BASE_URL=http://localhost:11434/v1
# PRIMARY_MODEL=codellama
# REASONER_MODEL=codellama
# LLM_API_KEY=not-needed-for-ollama

# ============================================================================
# Optional: Alternative LLM Providers
# ============================================================================

# Anthropic (Claude)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google (Gemini)
# GOOGLE_API_KEY=your_google_api_key_here

# ============================================================================
# Development Settings
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Enable logfire (for Pydantic AI monitoring)
# Options: always, if-token-present, never
LOGFIRE_SEND_TO_LOGFIRE=never

# ============================================================================
# Notes
# ============================================================================

# Required for basic usage:
#   - LLM_API_KEY (or local Ollama setup)
#   - OPENAI_API_KEY (for embeddings)
#   - SUPABASE_URL + SUPABASE_SERVICE_KEY (for RAG)

# Optional but recommended:
#   - CHECKPOINT_DB (for V4/V6 persistence)

# Use case specific:
#   - OPENWEATHER_API_KEY (weather agent example)
#   - Other API keys as needed for your agents

# Security best practices:
#   - Never commit .env files to version control
#   - Use different keys for development/production
#   - Rotate keys regularly
#   - Use minimal permissions where possible
